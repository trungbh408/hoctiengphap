  "stories": [
    {
      "level": "A1",
      "title": "Un matin à Strasbourg",
      "paragraphs": [
        "Il est huit heures. Camille habite à Strasbourg. Elle prend son petit-déjeuner dans sa cuisine.",
        "Elle boit un café et mange du pain. Ensuite, elle marche jusqu'à l'arrêt de bus.",
        "À neuf heures, Camille arrive au travail. Elle dit bonjour à ses collègues."
      ],
      "vi": "Một buổi sáng ở Strasbourg: Camille ăn sáng, đi xe buýt và chào đồng nghiệp."
    },
    {
      "level": "A1",
      "title": "Au marché",
      "paragraphs": [
        "Samedi matin, Paul va au marché. Il veut acheter des pommes, du pain et du lait.",
        "La vendeuse dit : « Bonjour monsieur ! » Paul répond : « Bonjour, je voudrais un kilo de pommes, s'il vous plaît. »",
        "Paul paie et rentre chez lui. Il est content."
      ],
      "vi": "Đi chợ: Paul mua thực phẩm và trò chuyện với người bán."
    },
    {
      "level": "A2",
      "title": "Une journée de pluie",
      "paragraphs": [
        "Hier, il pleuvait quand Léa est sortie de chez elle. Elle portait un manteau et avait un parapluie.",
        "Pendant qu'elle attendait le bus, elle a rencontré son voisin. Ils ont parlé de leur quartier.",
        "Quand le bus est arrivé, Léa a dit au revoir et elle est montée."
      ],
      "vi": "Một ngày mưa: luyện phân biệt imparfait và passé composé."
    },
    {
      "level": "A2",
      "title": "Le rendez-vous oublié",
      "paragraphs": [
        "Hier, Marc travaillait à la maison. Il était très occupé et il ne regardait pas son téléphone.",
        "À quinze heures, sa sœur a appelé. Marc a compris qu'il avait oublié leur rendez-vous.",
        "Il a pris son vélo et il est arrivé vingt minutes plus tard. Sa sœur l'attendait devant le café."
      ],
      "vi": "Cuộc hẹn bị quên: luyện thì quá khứ trong giao tiếp."
    }
  ]
